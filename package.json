{
    "name": "jarvis-core",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node jarvis-core.mjs",
        "check": "node --check jarvis-core.mjs && node --check console.js",
        "test": "node --test",
        "test:survival": "set JARVIS_INTEGRATION=1&& node --test test/survival.test.mjs",
        "test:revive": "set JARVIS_INTEGRATION=1&& node --test test/revive.test.mjs",
        "test:subworker": "set JARVIS_INTEGRATION=1&& node --test test/subworker.test.mjs",
        "test:boardcard": "set JARVIS_INTEGRATION=1&& node --test test/boardcard.test.mjs",
        "test:store": "set JARVIS_INTEGRATION=1&& node --test test/store.test.mjs",
        "test:report": "set JARVIS_INTEGRATION=1&& node --test test/report.test.mjs",
        "test:credit": "set JARVIS_INTEGRATION=1&& node --test test/credit.test.mjs",
        "test:spawnslot": "set JARVIS_INTEGRATION=1&& node --test test/spawnslot.test.mjs",
        "test:schedulenudge": "set JARVIS_INTEGRATION=1&& node --test test/schedulenudge.test.mjs",
        "test:baton": "set JARVIS_INTEGRATION=1&& node --test test/batonhttp.test.mjs",
        "test:batonvoice": "set JARVIS_INTEGRATION=1&& node --test test/batonvoicehttp.test.mjs",
        "test:delegate": "set JARVIS_INTEGRATION=1&& node --test test/delegate.test.mjs",
        "test:search": "set JARVIS_INTEGRATION=1&& node --test test/search.test.mjs",
        "test:send": "set JARVIS_INTEGRATION=1&& node --test test/send.test.mjs",
        "test:cursorgap": "set JARVIS_INTEGRATION=1&& node --test test/cursorgap.test.mjs",
        "test:archive": "set JARVIS_INTEGRATION=1&& node --test test/archive.test.mjs",
        "test:deadspawn": "set JARVIS_INTEGRATION=1&& node --test test/deadspawn.test.mjs",
        "test:integration": "set JARVIS_INTEGRATION=1&& node --test",
        "verify:searchbox": "node test-support/verify-searchbox-browser.mjs",
        "verify:coordchip": "node test-support/verify-coordchip-browser.mjs",
        "verify:batonchip": "node test-support/verify-batonchip-browser.mjs"
    },
    "dependencies": {
        "node-pty": "^1.1.0",
        "playwright": "^1.48.0"
    }
}
